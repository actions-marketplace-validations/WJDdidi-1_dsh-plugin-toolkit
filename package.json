{
  "name": "dsh-plugin-toolkit",
  "version": "0.20.0",
  "description": "Preflight, release and test DeepSeek Harness plugins: check a folder or any GitHub repository, wait for npm to actually serve the version, and keep the market index honest.",
  "type": "module",
  "bin": {
    "dsh-plugin": "bin/dsh-plugin.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cli": "./lib/cli.mjs",
    "./fix": "./lib/fix.mjs",
    "./testkit": "./lib/testkit/index.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/badge.svg",
    "docs/card.png",
    "docs/ecosystem-audit-2026-11-03.txt",
    "scripts/benchmark-audit.mjs",
    "scripts/compatibility-sample.mjs",
    "examples/compatibility-sample/"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin-tooling",
    "release",
    "preflight",
    "github"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJDdidi-1/dsh-plugin-toolkit.git"
  },
  "homepage": "https://github.com/WJDdidi-1/dsh-plugin-toolkit#readme",
  "bugs": {
    "url": "https://github.com/WJDdidi-1/dsh-plugin-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "lint": "node --check bin/dsh-plugin.mjs",
    "benchmark": "node scripts/benchmark-audit.mjs",
    "compatibility": "node scripts/compatibility-sample.mjs",
    "snapshots": "UPDATE_SNAPSHOTS=1 node --test test/testkit.test.mjs"
  },
  "peerDependencies": {
    "jsdom": ">=26",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "main": "index.js"
}
