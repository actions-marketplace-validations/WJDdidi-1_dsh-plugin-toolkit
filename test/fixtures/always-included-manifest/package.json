{
  "name": "always-included-manifest-fixture",
  "version": "1.0.0",
  "description": "A plugin that exports package.json while omitting it from files",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "main": "index.js",
  "files": [
    "README.md",
    "index.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./manifest": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
