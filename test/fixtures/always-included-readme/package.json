{
  "name": "always-included-readme-fixture",
  "version": "1.0.0",
  "description": "A plugin that exports README.md while omitting it from files",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./readme": "./README.md"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
